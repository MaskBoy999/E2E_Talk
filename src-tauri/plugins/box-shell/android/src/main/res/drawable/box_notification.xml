<!--
  The status-bar / shade icon for notifications on Android.

  Android needs a small icon that is a **white silhouette on transparent** — the
  system tints it (and on API 26+ it is drawn as a mask), so a coloured bitmap
  would come out as a blob. Without one, tauri-plugin-notification falls back to
  `android.R.drawable.ic_dialog_info` — the generic system "i" in a circle — which
  is what every message notification used to show in the shade.

  Wired up by `plugins.notification.icon` in tauri.conf.json, which the plugin's
  Kotlin half resolves as a drawable resource name. The name must match.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- A speech bubble with a tail: the app's own mark, in silhouette. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,3 L20,3 L20,17 L9,17 L4,21 Z" />
</vector>
