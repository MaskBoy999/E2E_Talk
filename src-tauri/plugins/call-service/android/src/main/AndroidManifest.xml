<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      "mediaCall" is NOT a foreground service type — AAPT rejects it and the
      whole APK fails to build:
        AAPT: error: 'mediaCall' is incompatible with attribute
        foregroundServiceType. It is absent from the attribute's flag list.
      The type for "continue an ongoing call" is `phoneCall`, which needs
      FOREGROUND_SERVICE_PHONE_CALL plus one of: this app being the default
      dialer, or MANAGE_OWN_CALLS declared. MANAGE_OWN_CALLS is a normal
      permission, so declaring it is enough — no runtime prompt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!--
      Android 14 (API 34) requires a *type-specific* permission for every
      foreground-service type the service claims, and `phoneCall` alone is the
      wrong type for this app: it means "continue a call through Telecom's
      ConnectionService", while what the call actually does is keep capturing
      the **microphone** from the background.

      That distinction is not cosmetic. Microphone (and camera) access is subject
      to Android's *while-in-use* restriction: the moment the app stops being the
      foreground app, the system revokes capture unless a foreground service is
      running with the `microphone` type. With only `phoneCall` declared, a voice
      call with the screen off went silent about ten seconds in — the sender
      stayed open but the OS had already cut the mic — and after a long
      background stretch the track never recovered, so audio only came back on a
      rejoin. `camera` and `mediaProjection` are the same story for video calls
      and screen share.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Required for getDisplayMedia() screen capture: the WebChromeClient needs
         this permission to grant MediaProjection requests. Without it, the
         display-capture picker may open but the track is never returned. -->
    <uses-permission android:name="android.permission.MEDIA_PROJECTION" />
    <!-- Media capture for calls. wry's RustWebChromeClient.onPermissionRequest
         turns the WebView's AUDIO_CAPTURE / VIDEO_CAPTURE requests into the
         matching Android runtime prompt (RECORD_AUDIO, CAMERA) — but only for
         permissions the *merged manifest* declares; for anything undeclared the
         prompt is auto-denied and getUserMedia fails, i.e. a call with no audio
         and a video call with no picture. Declaring them here means the plugin
         manifest carries them into the app. (MODIFY_AUDIO_SETTINGS is a normal
         permission: granted at install, never prompted.) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ring over the lock screen / other apps while the WebView is frozen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application>
        <!-- merged into the app manifest at build time -->

        <!--
          Picture-in-picture needs the activity to opt in, and this is the only
          durable place to say so.

          The Android WebView implements neither `document.pictureInPictureEnabled`
          nor `HTMLVideoElement.requestPictureInPicture()` (caniwebview lists the
          feature as unsupported in WebView on every version — Chrome-for-Android
          got it in 105, but that is a different embedding), so on a phone the PiP
          button reported "not supported". The box uses *activity* PiP instead:
          `Activity.enterPictureInPictureMode()` shrinks the whole window, and the
          page lifts the chosen tile into a full-viewport wrapper so that is what
          the window shows (see Pip.kt).

          That call throws unless the activity declares
          `android:supportsPictureInPicture="true"`. The activity lives in
          `src-tauri/gen/android/`, which is generated by `tauri android init` and
          is not tracked (the CI re-inits it whenever it is absent), so the
          attribute cannot be edited there — it is contributed here and merged in
          by the manifest merger.

          The name MUST be fully qualified and MUST match the generated activity
          (com.<app identifier>.MainActivity — the identifier is
          `src-tauri/tauri.conf.json` → `identifier`). The merger keys nodes by
          element type + resolved name, so this merges into the app's own
          `<activity android:name=".MainActivity">` entry instead of adding a
          second one; `tools` attributes are deliberately not needed because the
          app declares no `supportsPictureInPicture` of its own, so there is
          nothing to replace. tests/android-plugin-startup.spec.ts fails if this
          line or the identifier drifts.
        -->
        <activity
            android:name="com.e2echat.app.MainActivity"
            android:supportsPictureInPicture="true" />
        <!-- The types this service may claim. It is started with only the ones
             the call is actually using (CallForegroundService.buildTypeMask), so
             an audio-only call never asks for the camera type — claiming a type
             whose runtime permission is not held is itself a SecurityException. -->
        <service
            android:name="com.e2echat.callservice.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera|mediaProjection" />

        <receiver
            android:name="com.e2echat.callservice.IncomingCallActionReceiver"
            android:exported="false" />
        <!-- 1.1: Mute / Deafen / Hang up on the ongoing call notification.
             Same delivery rules as the ring receiver: exported=false, and the
             action travels as an id/verb only (no user-visible text, no E2EE). -->
        <receiver
            android:name="com.e2echat.callservice.CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
